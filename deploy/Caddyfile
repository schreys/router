{
	admin off
	auto_https off
}

:{$PORT} {
	encode gzip

	handle /segments.json {
		root * /app/brouter
		file_server
	}

	handle /places.json {
		root * /app/data
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle /brouter* {
		reverse_proxy localhost:17777
	}

	handle {
		root * /srv/www
		# Always revalidate (cheap 304 when unchanged), so changes to app.js/style.css show up right away.
		header Cache-Control "no-cache"
		file_server
	}
}
